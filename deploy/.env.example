# watERPax production env — copy to deploy/.env and fill in real values.
# deploy/.env is gitignored (the root ".env" pattern matches at any depth).
# Every var below is required: the compose file fails fast with a clear
# error if any is missing.

# Images built by CI (github workflows/docker.yml) and pushed to GHCR.
# Replace <owner>/<repo> with the lowercase GitHub owner/repo.
BACKEND_IMAGE=ghcr.io/owner/waterpax-backend:latest
WEB_IMAGE=ghcr.io/owner/waterpax-web:latest

# Postgres superuser/role password for the waterpax container DB
POSTGRES_PASSWORD=change-me-strong

# Auth
JWT_SECRET=change-me-64-random-chars
ADMIN_PASSWORD=change-me-strong

# Frontend origin allowed by the backend (no trailing slash)
CORS_ORIGIN=https://waterpax.com.ng

# true once served over https (Cloudflare). Set false only for plain-http testing.
COOKIE_SECURE=true

LOG_LEVEL=info
